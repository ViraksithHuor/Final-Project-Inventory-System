{{> page-header
  eyebrow="Administration"
  heading="API Key Management"
  description="Manage active API keys for integrations and service-level access."
  actionLabel="Generate New Key"
}}

<section class="content-grid two-column">
  <div class="panel">
    <h3>Create New API Key</h3>
    <form action="#" method="post" class="stack-form">
      <div class="form-group">
        <label for="keyLabel">Key Label</label>
        <input type="text" id="keyLabel" name="keyLabel" placeholder="e.g. Monitoring Service" />
      </div>

      <div class="form-group">
        <label for="keyPurpose">Purpose</label>
        <textarea id="keyPurpose" name="keyPurpose" rows="4" placeholder="Describe what this key will be used for"></textarea>
      </div>

       <button type="submit" class="btn btn-primary">Generate Key</button>
    </form>

    <div class="message-box success">
      Placeholder: generated raw key would be shown here once, after backend integration.
    </div>
  </div>

  <div class="panel">
    <div class="panel-header">
      <h3>Active API Keys</h3>
      <span class="badge neutral">6 Keys</span>
    </div>

    <div class="key-list">
      <article class="key-card">
        <div>
          <strong>Monitoring Service</strong>
          <p>Created: 2026-04-01</p>
        </div>
        <button class="btn btn-danger btn-sm" type="button">Revoke</button>
      </article>

      <article class="key-card">
        <div>
          <strong>Inventory Sync</strong>
          <p>Created: 2026-03-19</p>
        </div>
        <button class="btn btn-danger btn-sm" type="button">Revoke</button>
      </article>

      <article class="key-card">
        <div>
          <strong>Reporting Tool</strong>
          <p>Created: 2026-03-10</p>
        </div>
        <button class="btn btn-danger btn-sm" type="button">Revoke</button>
      </article>
    </div>
  </div>
</section>
