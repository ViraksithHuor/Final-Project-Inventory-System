{{> page-header
  eyebrow="Administration"
  heading="User List"
  description="Browse user accounts and open a detailed view for each user."
  actionLabel="Add User"
}}

<section class="panel">
  <div class="toolbar">
    <input type="text" class="search-input" placeholder="Search users..." />
    <select>
      <option>All Roles</option>
      <option>Admin</option>
      <option>Technician</option>
    </select>
    <select>
      <option>All Status</option>
      <option>Enabled</option>
      <option>Disabled</option>
    </select>
  </div>

    <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Username</th>
          <th>Email</th>
          <th>Role</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>admin_main</td>
          <td>admin@company.com</td>
          <td><span class="badge primary">Admin</span></td>
          <td><span class="badge success">Enabled</span></td>
          <td><a href="/admin/users/1" class="btn btn-sm">View Details</a></td>
        </tr>
        <tr>
          <td>david_tech</td>
          <td>david@company.com</td>
          <td><span class="badge neutral">Technician</span></td>
          <td><span class="badge success">Enabled</span></td>
          <td><a href="/admin/users/2" class="btn btn-sm">View Details</a></td>
        </tr>
        <tr>
          <td>sokha_it</td>
          <td>sokha@company.com</td>
          <td><span class="badge neutral">Technician</span></td>
          <td><span class="badge muted">Disabled</span></td>
          <td><a href="/admin/users/3" class="btn btn-sm">View Details</a></td>
        </tr>
      </tbody>
    </table>
  </div>
</section>