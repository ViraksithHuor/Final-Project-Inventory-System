{{> page-header
  eyebrow="Inventory"
  heading="Create New Item"
  description="Add a new asset into the inventory system."
}}

<section class="panel form-panel">
  <form id="createItemForm" class="form-grid">
    <div class="form-group">
      <label for="itemId">Item ID</label>
      <input type="text" id="itemId" name="itemId" placeholder="e.g. LT-1008" required />
    </div>

    <div class="form-group">
      <label for="serialNumber">Serial Number</label>
      <input type="text" id="serialNumber" name="serialNumber" placeholder="Enter serial number" required />
    </div>

    <div class="form-group">
      <label for="brand">Brand</label>
      <input type="text" id="brand" name="brand" placeholder="e.g. Lenovo" required />
    </div>

    <div class="form-group">
      <label for="model">Model</label>
      <input type="text" id="model" name="model" placeholder="e.g. ThinkPad E14" required />
    </div>

    <div class="form-group">
      <label for="category">Category</label>
      <select id="category" name="category" required>
        <option value="">Select a category</option>
        <option value="Laptop">Laptop</option>
        <option value="Desktop">Desktop</option>
        <option value="Server">Server</option>
        <option value="Monitor">Monitor</option>
        <option value="Keyboard">Keyboard</option>
        <option value="Other">Other</option>
      </select>
    </div>

    <div class="form-group">
      <label for="status">Status</label>
      <select id="status" name="status" required>
        <option value="Available">Available</option>
        <option value="In-Use">In-Use</option>
        <option value="Maintenance">Maintenance</option>
        <option value="Retired">Retired</option>
      </select>
    </div>

    <div class="form-group form-group--full">
      <label for="dateAcquired">Date Acquired</label>
      <input type="date" id="dateAcquired" name="dateAcquired" required />
    </div>

    <div class="form-actions form-group--full">
      <button type="submit" class="btn btn-primary">Create Item</button>
      <button type="reset" class="btn btn-secondary">Clear</button>
    </div>
  </form>
</section>

<script>
  document.getElementById('createItemForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const itemData = {
      itemId: document.getElementById('itemId').value,
      serialNumber: document.getElementById('serialNumber').value,
      brand: document.getElementById('brand').value,
      model: document.getElementById('model').value,
      category: document.getElementById('category').value,
      status: document.getElementById('status').value,
      dateAcquired: document.getElementById('dateAcquired').value
    };
    
    try {
      if (!isAuthenticated()) {
        throw new Error('You must be logged in to create an item');
      }
      
      const response = await Items.create(itemData);
      showMessage('Item created successfully!', 'success');
      document.getElementById('createItemForm').reset();
      
      setTimeout(() => {
        window.location.href = '/inventory';
      }, 1500);
    } catch (error) {
      handleError(error);
    }
  });
</script>