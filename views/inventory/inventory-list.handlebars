{{> page-header
  eyebrow="Inventory"
  heading="Inventory List"
  description="View all assets and open each item for more details."
  actionLabel="Add New Item"
  actionHref="/inventory/create"
}}

<section class="panel">
  <div class="toolbar">
    <input type="text" class="search-input" id="itemSearch" placeholder="Search by item ID, serial number, or model..." />
    <select id="categoryFilter">
      <option value="">All Categories</option>
      <option value="Laptop">Laptop</option>
      <option value="Desktop">Desktop</option>
      <option value="Server">Server</option>
      <option value="Monitor">Monitor</option>
      <option value="Keyboard">Keyboard</option>
      <option value="Other">Other</option>
    </select>
    <select id="statusFilter">
      <option value="">All Status</option>
      <option value="Available">Available</option>
      <option value="In-Use">In-Use</option>
      <option value="Maintenance">Maintenance</option>
      <option value="Retired">Retired</option>
    </select>
  </div>

  <div class="table-wrap">
    <table class="data-table">
      <thead>
        <tr>
          <th>Item ID</th>
          <th>Serial Number</th>
          <th>Brand</th>
          <th>Model</th>
          <th>Status</th>
          <th>Action</th>
        </tr>
      </thead>
      <tbody id="itemTableBody">
        <tr>
          <td colspan="6" style="text-align: center; padding: 20px;">Loading items...</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<script>
  function getToken() {
    return localStorage.getItem('token');
  }

  async function apiRequest(url) {
    const token = getToken();

    const response = await fetch(url, {
      headers: {
        Authorization: `Bearer ${token}`
      }
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.message || 'Request failed');
    }

    return data;
  }

  let allItems = [];
  
  async function loadItems() {
    try {
      const data = await apiRequest('/api/items');
      allItems = Array.isArray(data) ? data : (data.items || []);
      renderItems(allItems);
    } catch (error) {
      document.getElementById('itemTableBody').innerHTML = 
        `<tr><td colspan="6" style="text-align: center; color: red;">Error loading items: ${error.message}</td></tr>`;
      
      if (typeof handleError === 'function') {
        handleError(error);
      }
    }
  }
  
  function getStatusBadgeClass(status) {
    switch(status) {
      case 'Available': return 'success';
      case 'In-Use': return 'primary';
      case 'Maintenance': return 'warning';
      case 'Retired': return 'muted';
      default: return 'neutral';
    }
  }
  
  function renderItems(items) {
    const tbody = document.getElementById('itemTableBody');
    
    if (items.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" style="text-align: center;">No items found</td></tr>';
      return;
    }
    
    tbody.innerHTML = items.map(item => `
      <tr>
        <td>${item.itemId || 'N/A'}</td>
        <td>${item.serialNumber || 'N/A'}</td>
        <td>${item.brand || 'N/A'}</td>
        <td>${item.model || 'N/A'}</td>
        <td><span class="badge ${getStatusBadgeClass(item.status)}">${item.status || 'N/A'}</span></td>
        <td><a href="/inventory/${item._id}" class="btn btn-sm">View Details</a></td>
      </tr>
    `).join('');
  }
  
  function filterItems() {
    const searchTerm = document.getElementById('itemSearch').value.toLowerCase();
    const categoryFilter = document.getElementById('categoryFilter').value;
    const statusFilter = document.getElementById('statusFilter').value;
    
    let filtered = allItems.filter(item => {
      const matchesSearch = 
        (item.itemId || '').toLowerCase().includes(searchTerm) ||
        (item.serialNumber || '').toLowerCase().includes(searchTerm) ||
        (item.model || '').toLowerCase().includes(searchTerm);
      
      const matchesCategory = !categoryFilter || item.category === categoryFilter;
      const matchesStatus = !statusFilter || item.status === statusFilter;
      
      return matchesSearch && matchesCategory && matchesStatus;
    });
    
    renderItems(filtered);
  }
  
  document.getElementById('itemSearch').addEventListener('input', filterItems);
  document.getElementById('categoryFilter').addEventListener('change', filterItems);
  document.getElementById('statusFilter').addEventListener('change', filterItems);
  
  loadItems();
</script>