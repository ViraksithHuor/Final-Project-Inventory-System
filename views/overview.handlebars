{{> page-header
  eyebrow="Dashboard"
  heading="Overview"
  description="Quick summary of the current inventory status and aging assets."
}}

<section class="stats-grid">
  <article class="stat-card">
    <p>Total Assets</p>
    <h3 id="totalAssets">0</h3>
    <span>All tracked inventory items</span>
  </article>

  <article class="stat-card">
    <p>Deployed Items</p>
    <h3 id="deployedItems">0</h3>
    <span>Currently assigned or in use</span>
  </article>
  
  <article class="stat-card">
    <p>Available Items</p>
    <h3 id="availableItems">0</h3>
    <span>Ready for future deployment</span>
  </article>
  
  <article class="stat-card warning">
    <p>Older Than 3 Years</p>
    <h3 id="agingItems">0</h3>
    <span>May need review or replacement</span>
  </article>
</section>

<section class="content-grid two-column">
  <div class="panel">
    <div class="panel-header">
      <h3>Inventory Summary by Category</h3>
      <span class="badge neutral">Live Data</span>
    </div>
    
    <div class="summary-list" id="categorySummary">
      <p style="text-align: center; padding: 20px;">Loading inventory data...</p>
    </div>
  </div>
  
  <div class="panel">
    <div class="panel-header">
      <h3>Items Over 3 Years Old</h3>
      <span class="badge warning">Attention</span>
    </div>

    <div class="aging-list" id="agingItemsList">
      <p style="text-align: center; padding: 20px;">Loading aging items...</p>
    </div>
  </div>
</section>

<script>
  function isAuthenticated() {
    return !!localStorage.getItem('token');
  }

  async function apiRequest(url, options = {}) {
    const token = localStorage.getItem('token');

    const response = await fetch(url, {
      ...options,
      headers: {
        ...(options.headers || {}),
        Authorization: `Bearer ${token}`
      }
    });

    const data = await response.json();

    if (!response.ok) {
      throw new Error(data.message || 'Request failed');
    }

    return data;
  }

  async function loadDashboardData() {
    try {
      if (!isAuthenticated()) {
        throw new Error('You must be logged in');
      }

      const items = await apiRequest('/api/items');
      const itemsArray = Array.isArray(items) ? items : (items.items || []);

      const totalAssets = itemsArray.length;
      const deployedItems = itemsArray.filter(i => i.status === 'In-Use').length;
      const availableItems = itemsArray.filter(i => i.status === 'Available').length;

      const threeYearsAgo = new Date();
      threeYearsAgo.setFullYear(threeYearsAgo.getFullYear() - 3);

      const agingItems = itemsArray.filter(i => {
        if (!i.dateAcquired) return false;
        const acqDate = new Date(i.dateAcquired);
        return acqDate < threeYearsAgo;
      });

      document.getElementById('totalAssets').textContent = totalAssets;
      document.getElementById('deployedItems').textContent = deployedItems;
      document.getElementById('availableItems').textContent = availableItems;
      document.getElementById('agingItems').textContent = agingItems.length;

      const categories = {};

      itemsArray.forEach(item => {
        const cat = item.category || 'Other';
        categories[cat] = (categories[cat] || 0) + 1;
      });

      const categorySummary = document.getElementById('categorySummary');

      const categoryHtml = Object.entries(categories)
        .map(([cat, count]) => `
          <div class="summary-row">
            <span>${cat}</span>
            <strong>${count}</strong>
          </div>
        `)
        .join('');

      categorySummary.innerHTML = categoryHtml || '<p style="text-align: center;">No data available</p>';

      const agingList = document.getElementById('agingItemsList');

      if (agingItems.length === 0) {
        agingList.innerHTML = '<p style="text-align: center;">No aging items</p>';
      } else {
        agingList.innerHTML = agingItems.slice(0, 4).map(item => `
          <article class="aging-item">
            <strong>${item.itemId || 'N/A'} · ${item.brand || ''} ${item.model || ''}</strong>
            <p>Acquired: ${new Date(item.dateAcquired).toLocaleDateString()}</p>
          </article>
        `).join('');
      }
    } catch (error) {
      console.error('Error loading dashboard data:', error);

      document.getElementById('categorySummary').innerHTML =
        `<p style="color: red; text-align: center;">Error loading inventory data: ${error.message}</p>`;

      document.getElementById('agingItemsList').innerHTML =
        `<p style="color: red; text-align: center;">Error loading aging items</p>`;

      if (typeof handleError === 'function') {
        handleError(error);
      }
    }
  }

  loadDashboardData();
</script>
