<section class="page-header">
  <div>
    <p class="eyebrow">{{eyebrow}}</p>
    <h2>{{heading}}</h2>
    {{#if description}}
      <p class="page-description">{{description}}</p>
    {{/if}}
  </div>

  {{#if actionLabel}}
    <div>
      <button class="btn btn-primary" type="button">{{actionLabel}}</button>
    </div>
  {{/if}}
</section>