<header class="topbar">
  <div>
    <p class="eyebrow">Internal Tool</p>
    <h1 class="topbar-title">{{title}}</h1>
  </div>

  <div class="topbar-actions">
    <div class="user-chip" id="userChip">
      <div class="user-avatar" id="userAvatar">-</div>
      <div>
        <strong id="userName">Loading...</strong>
        <p id="userRole">UI</p>
      </div>
    </div>
    <button class="btn btn-secondary btn-sm" onclick="logout()" style="margin-left: 20px;">Logout</button>
  </div>
</header>

<script>
  function loadUserInfo() {
    const token = getToken();
    if (token) {
      try {
        const payload = JSON.parse(atob(token.split('.')[1]));
        document.getElementById('userName').textContent = payload.username || 'User';
        document.getElementById('userRole').textContent = payload.role || 'User';
        document.getElementById('userAvatar').textContent = (payload.username || 'U')[0].toUpperCase();
      } catch (e) {
        console.error('Error parsing token:', e);
      }
    } else {
      window.location.href = '/login';
    }
  }
  
  function logout() {
    Auth.logout();
    window.location.href = '/login';
  }
  
  loadUserInfo();
</script>